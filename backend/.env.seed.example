# Demo-school seed credentials (Issue #166) — EXAMPLE, safe to commit.
#
# Copy to `.env.seed` (gitignored, never committed) and adjust:
#     cp backend/.env.seed.example backend/.env.seed
#
# The seed scripts (scripts/seed_admin.py, scripts/seed_classroom_demo.py)
# load `.env.seed` with override=False, so real environment variables win.
# DATABASE_URL is intentionally NOT here — it stays in `.env` / environment.
#
# Gate: ALLOW_DEMO_SEED=1 + DATABASE_SEARCH_PATH=codecoach_test seeds the
# isolated test schema. The authorized live run additionally requires
# DATABASE_SEARCH_PATH=public + SEED_LIVE_CONFIRM=YES-I-AM-SURE.
ALLOW_DEMO_SEED=1

# Live-run double-key (leave commented out unless doing the authorized run).
# SEED_LIVE_CONFIRM=YES-I-AM-SURE

# Dev-only demo passwords (same convention as the in-code defaults).
SEED_ADMIN_PASSWORD=admin123
SEED_SUPERADMIN_PASSWORD=superadmin123
SEED_PROFESSOR_PASSWORD=professor123
SEED_TA_PASSWORD=demonstrator123
SEED_STUDENT_PASSWORD=student123
