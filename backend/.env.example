# Groq API Key (required for AI coaching)
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model overrides (optional — defaults shown)
# GROQ_MODEL_EASY=openai/gpt-oss-20b
# GROQ_MODEL_MEDIUM=openai/gpt-oss-120b
# GROQ_MODEL_HARD=openai/gpt-oss-120b
# GROQ_MODEL_STREAM=openai/gpt-oss-20b
# GROQ_MODEL_ANIMATE=openai/gpt-oss-120b

# Per-user daily token caps (optional — defaults shown)
# DAILY_TOKEN_INPUT_CAP=250000
# DAILY_TOKEN_OUTPUT_CAP=125000

# Per-user requests-per-minute limit (optional — default 60)
# USER_RATE_LIMIT_PER_MINUTE=60

# Database (Supabase PostgreSQL is the primary database)
# Transaction-mode pooler for the app runtime:
#   postgresql://postgres.<ref>.<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session-mode pooler (used for migrations / schema tooling):
#   postgresql://postgres.<ref>.<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.your-project-ref.pooler.supabase.com:6543/postgres?pgbouncer=true

# Tests: point DATABASE_URL at a LOCAL Postgres for speed (same dialect as
# Supabase; the conftest creates a `codecoach_test` schema for isolation).
#   docker run -d --name codecoach-testdb -e POSTGRES_DB=codecoach_test \
#     -e POSTGRES_USER=codecoach -e POSTGRES_PASSWORD=codecoach \
#     -p 5433:5432 postgres:16-alpine
#   DATABASE_URL=postgresql://codecoach:codecoach@127.0.0.1:5433/codecoach_test

# Session-mode pooler used for migrations and schema tooling
# DIRECT_URL=postgresql://postgres.your-project-ref.pooler.supabase.com:5432/postgres

# Piston (code execution) — uncomment for local Piston
# PISTON_API_URL=http://localhost:2000/api/v2/piston

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development

# Supabase Auth / OAuth (Google) — used to verify Supabase OAuth tokens.
# IMP: current project is the TEST database + TEST OAuth (see Docs/TEST_ENVIRONMENT.md).
# Publishable (public) key from Dashboard > Settings > API Keys.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
