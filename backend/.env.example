# Groq API Key (required for AI coaching)
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model overrides (optional — defaults shown)
# GROQ_MODEL_EASY=llama-3.1-8b-instant
# GROQ_MODEL_MEDIUM=llama-3.3-70b-versatile
# GROQ_MODEL_HARD=llama-3.3-70b-versatile
# GROQ_MODEL_STREAM=llama-3.1-8b-instant

# Per-user daily token caps (optional — defaults shown)
# DAILY_TOKEN_INPUT_CAP=250000
# DAILY_TOKEN_OUTPUT_CAP=125000

# Per-user requests-per-minute limit (optional — default 60)
# USER_RATE_LIMIT_PER_MINUTE=60

# Database (MySQL is the primary database)
# MySQL:    mysql+aiomysql://user:password@host.docker.internal:3306/codecoach
DATABASE_URL=mysql+aiomysql://codecoach:codecoach@host.docker.internal:3306/codecoach

# Piston (code execution) — uncomment for local Piston
# PISTON_API_URL=http://localhost:2000/api/v2/piston

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
