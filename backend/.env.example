# Groq API Key (required for AI coaching)
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model overrides (optional — defaults shown)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL_EASY=openai/gpt-oss-20b
# GROQ_MODEL_MEDIUM=openai/gpt-oss-120b
# GROQ_MODEL_HARD=openai/gpt-oss-120b
# GROQ_MODEL_STREAM=openai/gpt-oss-20b
# GROQ_MODEL_ANIMATE=openai/gpt-oss-120b

# Per-user daily token caps (optional — defaults shown)
# DAILY_TOKEN_INPUT_CAP=250000
# DAILY_TOKEN_OUTPUT_CAP=125000

# Per-user requests-per-minute limit (optional — default 60)
# USER_RATE_LIMIT_PER_MINUTE=60

# Database — local PostgreSQL branch database (PostgreSQL is the only engine).
# Create it with: python scripts/branch_db.py init --url <DATABASE_URL>
DATABASE_URL=postgresql://codecoach:codecoach@127.0.0.1:5432/codecoach_<branch-slug>

# Tests use the same local server (conftest refuses non-local hosts).
# The suite creates isolated schemas, so no separate test database is needed.

# Live PostgreSQL (promotion target only — never point the app at this for
# daily work; writes go through scripts/branch_db.py promote with the
# PROMOTE_TO_LIVE confirm token):
# LIVE_DATABASE_URL=postgresql://user:password@live-host:5432/postgres

# Piston (code execution) — uncomment for local Piston
# PISTON_API_URL=http://localhost:2000/api/v2/piston

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Environment
ENVIRONMENT=development
