{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [".opencode/plugins/graphify.js", "rishav-antigravity-auth@1.2.8"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "-y", "shadcn-registry-mcp"],
      "enabled": true
    },
    "21st-dev": {
      "type": "local",
      "command": ["npx", "-y", "@21st-dev/magic@latest"],
      "enabled": true,
      "env": {
        "TWENTY_FIRST_API_KEY": "${TWENTY_FIRST_API_KEY}"
      }
    }
  }
}
