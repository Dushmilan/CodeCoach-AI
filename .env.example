# Copy this to .env and fill in your actual values
# Required: NVIDIA NIM API Key
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Frontend configuration
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# For production deployment (replace with your domain/IP):
# NEXT_PUBLIC_API_URL=https://your-domain.com
# NEXT_PUBLIC_WS_URL=wss://your-domain.com

# Backend configuration (optional - defaults shown)
# Database URL (SQLite for dev, PostgreSQL for production via Supabase)
# SQLite:   sqlite+aiosqlite:///./codecoach.db
# Supabase: postgresql+asyncpg://user:password@host:5432/codecoach
DATABASE_URL=sqlite+aiosqlite:///./codecoach.db
# Set to true to use the database instead of JSON files
USE_DATABASE=false
# PISTON_API_URL=http://piston:2000/api/v2
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
