# Copy this to .env and fill in your actual values (never commit .env).
# Supabase/PostgreSQL is the ONLY supported database.

# Environment (development | production). Unset = production (fail-closed).
ENVIRONMENT=development

# Database — Supabase connection string (transaction-mode pooler for the app):
DATABASE_URL=postgresql://postgres.your-project-ref.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session-mode pooler for migrations / schema tooling:
DIRECT_URL=postgresql://postgres.your-project-ref.pooler.supabase.com:5432/postgres

# Auth (server-side only, never expose to the browser)
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32

# AI coaching (server-side only)
GROQ_API_KEY=your_groq_api_key_here

# Code execution
# PISTON_API_URL=http://piston:2000/api/v2

# Supabase Auth / OAuth — get from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx  # publishable (public) key — Dashboard > Settings > API Keys
# IMP: current project is the TEST database + TEST OAuth (see Docs/TEST_ENVIRONMENT.md)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx  # publishable (public) key — Dashboard > Settings > API Keys

# Frontend configuration
# Local development (browser must reach this):
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Production deployment (replace with your domain/IP):
# NEXT_PUBLIC_API_URL=https://your-domain.com
# NEXT_PUBLIC_WS_URL=wss://your-domain.com

# Optional tunables (defaults shown)
# DAILY_TOKEN_INPUT_CAP=250000
# DAILY_TOKEN_OUTPUT_CAP=125000
# USER_RATE_LIMIT_PER_MINUTE=60
