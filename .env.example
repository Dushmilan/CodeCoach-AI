# Copy this to .env and fill in your actual values (never commit .env).
# Local PostgreSQL is the working database (one database per git branch).

# Environment (development | production). Unset = production (fail-closed).
ENVIRONMENT=development

# Database — local PostgreSQL branch database (see AGENTS.md: one database
# per git branch, created with backend/scripts/branch_db.py init):
DATABASE_URL=postgresql://codecoach:codecoach@127.0.0.1:5432/codecoach_<branch-slug>
# Inside docker compose, the backend reaches the bundled postgres service as:
# DATABASE_URL=postgresql://codecoach:codecoach@postgres:5432/codecoach_<branch-slug>

# Auth (server-side only, never expose to the browser)
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32

# AI coaching (server-side only)
GROQ_API_KEY=your_groq_api_key_here

# Code execution
# PISTON_API_URL=http://piston:2000/api/v2

# Frontend configuration
# Local development / Docker: leave empty for same-origin (the /api rewrite
# proxies to the backend; stays under CSP connect-src 'self'). A plain-http
# absolute URL is blocked by connect-src on every request (see #172).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Production deployment (replace with your domain/IP):
# NEXT_PUBLIC_API_URL=https://your-domain.com
# NEXT_PUBLIC_WS_URL=wss://your-domain.com

# Optional tunables (defaults shown)
# USER_RATE_LIMIT_PER_MINUTE=60
