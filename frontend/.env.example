# Backend API URL. Empty = same-origin (default): the browser calls /api/*
# on the Next.js server and the rewrite proxies to the backend. Same-origin
# stays under CSP connect-src 'self'. Set an absolute https: URL ONLY for a
# genuinely cross-origin API. A plain-http absolute URL is blocked by
# connect-src on every request (see #172).
# - Local dev / Docker: leave empty
# - Cloudflare production build (CI): https://api.yourdomain.com
# Read at BUILD time: inlined into the client bundle AND used for the /api/*
# rewrite destination baked into the Worker.
NEXT_PUBLIC_API_URL=

# Backend WebSocket URL (reserved; not currently used by the app).
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Public site URL (used by sitemap.xml). Set as a Worker runtime var in prod.
NEXT_PUBLIC_SITE_URL=https://codecoach.ai
